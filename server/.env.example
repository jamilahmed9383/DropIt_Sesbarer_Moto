# Set PORT in the process environment; default is 5000.
PORT=5000

# Maximum bytes allowed for one file and one transfer (default: 5 GiB).
MAX_FILE_BYTES=5368709120

# Optional comma-separated web origins. Android requests do not send a browser Origin.
CORS_ORIGIN=https://app.example.com

# Optional absolute persistent metadata directory. Default: server/data
# DATA_DIR=/srv/dropit/data

# Optional absolute verified-upload directory. Default: server/uploads/transfers
# TRANSFER_DIR=/srv/dropit/transfers
